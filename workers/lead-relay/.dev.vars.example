# Скопируй в .dev.vars (файл в .gitignore) для локального `npm run dev`.
# В продакшене эти значения задаются через `npx wrangler secret put <NAME>`.
#
# Воркер отвечает только за Telegram — переменные AMO_* сюда не нужны,
# они живут в .env сайта (в amoCRM ходит только серверный роут).

TG_BOT_TOKEN=
CHAT_ID=
# Только для беседы с темами (форум):
# CHAT_THREAD_ID=
