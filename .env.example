# Переменные приёма заявок. Скопировать в .env (он в .gitignore) для локальной
# работы; на Vercel те же имена задаются в Project Settings → Environment Variables.
#
# Полное описание маршрута, контракта и граблей — FORM.md.
# Значения со звёздочкой (*) заказчик выдаёт сам, в репозитории их нет.

# ─────────────────────────────────────────────────────────────────────────────
# Клиентские: инлайнятся в бандл на этапе `astro build`
# ─────────────────────────────────────────────────────────────────────────────

# Куда форма шлёт заявку. Относительный путь — намеренно: так работает и боевой
# домен, и любой превью-деплой Vercel, у которого адрес свой.
# ⚠️ Пока эта переменная И PUBLIC_LEAD_RELAY_URL пусты, форма сидит в ДЕМО-РЕЖИМЕ:
#    показывает успех и не отправляет ничего (FORM.md § 1).
PUBLIC_LEAD_ORIGIN_URL=/api/lead

# Cloudflare Worker для Telegram. На Vercel НЕ обязателен: пусто → сервер везёт
# оба канала одним запросом. Заполнять, только если воркер развёрнут
# (workers/lead-relay/README.md).
# PUBLIC_LEAD_RELAY_URL=https://taotransit-lead-relay.<account>.workers.dev

# Адрес сайта: из него собираются canonical, og:*, JSON-LD, robots.txt, sitemap.
# На переезде домена поставить https://taotransit.com — это же включает индексацию.
# PUBLIC_SITE_URL=https://taotransit.com

# Счётчики. Идентификаторы не секретны и уже вшиты в src/scripts/analytics.ts:
# Яндекс Метрика 112274964 и Google-тег G-C19XJZ9B84. Переменные нужны для
# одного — погасить счётчик на отдельной сборке, задав ПУСТОЕ значение.
# Локальная сборка не считается никогда, отдельной настройки для этого не надо.
# PUBLIC_YM_ID=
# PUBLIC_GA_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Telegram — тот же бот, что у matestrade.com, но ОТДЕЛЬНАЯ беседа
# ─────────────────────────────────────────────────────────────────────────────

# * Токен бота. Тот же, что в /var/www/mate/.env у mate.
#   ⚠️ На этом токене НИКОГДА не вызывать setWebhook / deleteWebhook.
TG_BOT_TOKEN=

# * id беседы под заявки TAO. НОВАЯ беседа: заявки mate и TAO не смешиваем.
#   Найти: node scripts/tg-chat.mjs chats   (сначала node scripts/tg-chat.mjs whoami)
#   У супергрупп id отрицательный и начинается с -100 — минус обязателен.
CHAT_ID=

# Только если беседа с включёнными темами (форум) и писать надо в конкретную.
# CHAT_THREAD_ID=

# ─────────────────────────────────────────────────────────────────────────────
# amoCRM — тот же аккаунт и та же интеграция, что у mate, НО другая воронка
# ─────────────────────────────────────────────────────────────────────────────

AMO_SUBDOMAIN=mategrouptrade

# * Долгоживущий токен приватной интеграции (тот же, что у mate; живёт до 5 лет).
AMO_LONG_TOKEN=

# * id НОВОЙ воронки TAO. Без него сделки лягут в воронку mate.
#   Найти: node scripts/amo-fields.mjs pipelines
#   ⚠️ В воронке должно быть включено «Неразобранное», иначе заявка не создастся.
AMO_PIPELINE_ID=

# Чем заявки TAO отличаются от заявок mate в одном аккаунте. Задавать явно.
AMO_SOURCE_NAME=Сайт taotransit.com
AMO_SOURCE_UID=taotransit-website-form
AMO_FORM_ID=taotransit-contact-form

# Поле сделки под ответ на вопрос «Что нужно». Поле НЕ системное!
# ⚠️ Код несуществующего поля = 400 от amo и потеря ВСЕЙ заявки (FORM.md § 12, п. 8).
#    Поэтому переменная закомментирована: сначала убедиться, что поле есть —
#    node scripts/amo-fields.mjs list — и только потом раскомментировать.
#    Без неё ответ всё равно виден: он идёт в название сделки и в текст Telegram.
# AMO_ANSWER_FIELD=FORM_ANSWER

# ─────────────────────────────────────────────────────────────────────────────
# Необязательное
# ─────────────────────────────────────────────────────────────────────────────

# Добавочные origin-ы через запятую поверх ALLOWED_ORIGINS (src/lib/lead.js).
# Свой домен деплоя сервер разрешает сам, так что нужно это только чужому
# фронту — например, если форму встроят на другой сайт.
# LEAD_ALLOWED_ORIGINS=https://taotransit.vercel.app

# AMO_HOST=amocrm.ru
# AMO_LEAD_NAME=Заявка с сайта taotransit.com
# AMO_UTM_FIELD_IDS={"utm_source":123}     # аварийный маппинг, если метки в самодельных полях
# LEAD_CHANNELS=telegram,amo               # потолок каналов приёмника; у сервера по умолчанию оба
# OUTBOUND_TIMEOUT_MS=8000
