---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Achievements from '../components/Achievements.astro';
import WhyUs from '../components/WhyUs.astro';
import Services from '../components/Services.astro';
import Pricing from '../components/Pricing.astro';
import Steps from '../components/Steps.astro';
import Cases from '../components/Cases.astro';
import CasesCta from '../components/CasesCta.astro';
import About from '../components/About.astro';
import HowToStart from '../components/HowToStart.astro';
import Values from '../components/Values.astro';
import LeadForm from '../components/LeadForm.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main>
    <Hero />
    <Achievements />
    <WhyUs />
    <Services />
    <Pricing />
    <Steps />
    <Cases />
    <CasesCta />
    <About />
    <Values />
    <HowToStart />
    {/* Форма идёт сразу за ботом: секция выше объясняет, как устроена
        работа, и заканчивается кнопкой в бота — форма это второй способ
        начать, а не отдельная тема. Все ссылки на неё смотрят вперёд. */}
    <LeadForm />
  </main>
  <Footer />
</Layout>
