---
import '../styles/global.css';
import { site } from '../content/landing';
import ScrollTop from '../components/ScrollTop.astro';
import LegalDocs from '../components/LegalDocs.astro';
import CookieBanner from '../components/CookieBanner.astro';
import ogImage from '../assets/img/hero-poster.jpg';
import { isProductionHost } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage.src, Astro.site).href;

/* Пока сборка стоит не на боевом домене, она не должна попадать в выдачу:
   иначе превью станет дублем живого taotransit.com. Второй рубеж к тому,
   что уже написано в robots.txt, — поисковики читают оба. */
const indexable = isProductionHost(Astro.site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {/* Знак — два штриха из логотипа: единственная его часть, читаемая на 16px.
        SVG берут все актуальные браузеры, .ico остаётся запасным. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="TAO Transit" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'TAO Transit',
        description: site.description,
        url: canonical,
        foundingDate: '2013',
        areaServed: ['RU', 'KZ', 'UZ', 'CN'],
        sameAs: [site.channel, site.bot],
        contactPoint: {
          '@type': 'ContactPoint',
          contactType: 'sales',
          email: site.email,
          availableLanguage: ['ru'],
        },
      })}
    />

    <!-- Основное начертание грузим заранее: им набран весь первый экран -->
    <script is:inline>
      // без JS блоки видны сразу — начальное состояние анимаций ставится только здесь
      document.documentElement.classList.add('anim');
    </script>

    <!-- Предзагружаем только два начертания первого экрана: Regular (подписи
         hero) и Black (меню и заголовки секций). Semibold и Bold встречаются
         ниже сгиба и успевают приехать сами. Medium убран вместе с весом 500:
         пакет его не подключает, а в предзагрузке он стоил 16 КБ. -->
    <link rel="preload" href="/fonts/CraftworkSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/CraftworkSans-Black.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
    <ScrollTop />

    {/* Общие для всей страницы: документы открываются из футера, из строки
        согласия под формой и из плашки, а плашка ждёт ответа один раз. */}
    <LegalDocs />
    <CookieBanner />

    <script>
      import { initNav } from '../scripts/nav';
      import { initAnimations } from '../scripts/animations';
      import { initTimeline } from '../scripts/timeline';
      import { initLeadForm } from '../scripts/lead';
      import { initSelects } from '../scripts/select';
      import { initLegal } from '../scripts/legal';
      import { initAnalytics } from '../scripts/analytics';
      import { initContacts } from '../scripts/contacts';
      import { initCases } from '../scripts/cases';
      import { footer } from '../content/landing';
      /* Вся интерактивность страницы лежит в одном бандле, и без обёртки
         исключение в любом init уносило бы все следующие за ним. Дороже всего
         это стоило бы форме: она шла четвёртой, за таймлайном — самым сложным
         скриптом на странице (замер путей SVG, motion, document.fonts.ready).
         Упал бы он — форма осталась бы без обработчика submit. */
      const run = (name, init) => {
        try {
          init();
        } catch (error) {
          console.error(`init ${name} не отработал`, error);
        }
      };

      // Сначала то, ради чего страница существует: форма и её счётчик.
      run('lead', initLeadForm);
      run('selects', initSelects);
      run('analytics', initAnalytics);

      // Дальше — в прежнем порядке.
      run('nav', initNav);
      run('animations', initAnimations);
      run('timeline', initTimeline);
      run('legal', initLegal);
      run('contacts', () => initContacts(footer.copied));
      run('cases', initCases);
    </script>
  </body>
</html>
