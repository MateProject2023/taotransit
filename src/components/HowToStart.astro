---
import cover from '../assets/img/bot-video-cover.jpg';
import { howToStart, site } from '../content/landing';
import { qrCode } from '../lib/qr';
import { telegramLabel } from '../lib/telegram';

/* Второй код канала на странице. Первый — плитка в футере; здесь он мельче
   и стоит рядом с кнопкой, потому что это то же самое место разговора:
   бот — чтобы начать, канал — чтобы сначала посмотреть со стороны.

   112px на 33 модуля — 3.4px на модуль. Меньше 3px камера телефона берёт
   через раз, поэтому размер здесь снизу ограничен, а не выбран на глаз;
   `scripts/qr-audit.mjs` читает код в его настоящем размере. */
const channelQr = qrCode(site.channel);
const channelLabel = telegramLabel(site.channel);
---

{/*
  Две колонки, как в оригинале: слева утверждение и действие, справа
  доказательство. Одна вертикальная линия, стоявшая здесь до этого, уводила
  кнопку вниз — под ролик, который её объясняет, — и секция читалась длиннее,
  чем она есть.

  Ролик не ограничен по ширине отдельно: его держит своя колонка сетки.
*/}
<section id="howtostart" class="scroll-mt-24 py-16 sm:py-20 lg:py-24">
  <div class="site-container">
    {/*
      Три ячейки, а не две колонки: кнопка вынесена из текстового блока
      отдельным элементом сетки. На широком экране она встаёт под текст
      слева, а ролик занимает обе строки справа. На узком порядок в потоке
      даёт нужное чтение — утверждение, доказательство, действие; когда
      кнопка лежала внутри текстового блока, она оказывалась над роликом,
      то есть до того, чем она обоснована.
    */}
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:items-center lg:gap-x-14 lg:gap-y-10">
      <div class="lg:col-start-1 lg:row-start-1">
        <h2 class="section-title">
          {howToStart.title}
        </h2>

        <p class="mt-6 max-w-(--container-prose) text-xl leading-snug text-pretty sm:text-2xl lg:mt-8 lg:text-3xl">
          {howToStart.lead}
        </p>
      </div>

      <div class="lg:col-start-2 lg:row-span-2 lg:row-start-1">
        {/*
          Ролик лежит у нас, а не на Rutube: плеер и его трекеры со страницы ушли.
          preload="none" — до клика не качается ни байта, поэтому вес файла
          на первую загрузку не влияет.
        */}
        <div class="video-player relative overflow-hidden rounded-3xl border border-line bg-paper">
          <video
            class="aspect-video w-full"
            poster={cover.src}
            preload="none"
            playsinline
            controls={false}
          >
            <source src={howToStart.video.webm} type="video/webm" />
            <source src={howToStart.video.mp4} type="video/mp4" />
          </video>

          <button
            type="button"
            class="absolute inset-0 flex cursor-pointer items-center justify-center bg-ink/20 transition-colors hover:bg-ink/5"
          >
            <span class="sr-only">Смотреть видео: {howToStart.video.title}</span>
            <span
              class="flex size-16 items-center justify-center rounded-xl bg-brand text-white sm:size-20"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="ml-1 size-7 sm:size-9">
                <path d="M8 5v14l11-7z"></path>
              </svg>
            </span>
          </button>
        </div>

        {/* Подпись к ролику: одна строка по правому краю, мелко. Раньше это был
            отдельный призыв в 24px под кнопкой и он спорил с ней за внимание —
            а связь с менеджером здесь запасной ход, а не второй призыв. */}
        <p class="mt-3 text-right text-xs leading-snug text-ink-muted sm:text-sm">
          {howToStart.askLead}{' '}
          <a
            href={site.manager}
            target="_blank"
            rel="noopener"
            class="text-brand underline underline-offset-2 transition-colors hover:text-brand-deep"
          >
            {howToStart.askLink}
          </a>
        </p>
      </div>

      {/* Кнопка в бота — одна: секция про него, а форма идёт следом отдельной
          секцией, предлагать её здесь второй раз незачем.

          Рядом с ней код канала. Это не второй призыв и спорить с кнопкой он
          не должен: ни заливки, ни рамки, подпись вторичным серым — заказчик
          просил вставить канал «аккуратно, без забора внимания». */}
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-8 lg:col-start-1 lg:row-start-2">
        <a
          href={site.bot}
          target="_blank"
          rel="noopener"
          class="cta cta-brand w-full text-lg sm:w-auto sm:min-w-[18rem]"
        >
          {howToStart.cta}
        </a>

        {/* Подпись под кодом, а не сбоку: сбоку блок вырастал до 568px и не
            вставал рядом с кнопкой в колонку шириной 495px — строка
            переносилась, и «тихий ход» оказывался отдельной ступенью
            под кнопкой. Замер, а не догадка. */}
        <a
          href={site.channel}
          target="_blank"
          rel="noopener"
          class="group flex shrink-0 flex-col items-center gap-2 rounded-lg"
        >
          <svg
            viewBox={`0 0 ${channelQr.size} ${channelQr.size}`}
            class="size-28 text-brand"
            shape-rendering="crispEdges"
            data-qr
            aria-hidden="true"
            focusable="false"
          >
            <path d={channelQr.d} fill="currentColor" />
          </svg>
          <span class="text-center text-sm leading-snug text-ink-muted">
            {howToStart.channel}
            <span class="block underline decoration-[0.5px] underline-offset-4 transition-colors group-hover:text-ink">
              {channelLabel}
            </span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // до клика видео не загружается (preload="none"); клик включает
  // родные элементы управления и запускает воспроизведение
  document.querySelectorAll<HTMLElement>('.video-player').forEach((player) => {
    const video = player.querySelector('video');
    const button = player.querySelector('button');
    if (!video || !button) return;

    button.addEventListener('click', () => {
      video.controls = true;
      video.play();
      button.remove();
    });
  });
</script>
