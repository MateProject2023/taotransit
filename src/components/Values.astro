---
import { values } from '../content/landing';
---

{/*
  Секция залита брендовым, поэтому карточек здесь нет вовсе: карточка внутри
  залитой секции — это вложенная карточка, прямой запрет. Четыре записи
  обычным текстом, разделённые волосяными линиями.

  Тело набирается токеном --on-brand (#C0C3D1) из пакета: 6.10:1 на брендовом.
  Заголовки — чистый белый, 10.71:1.

  Индиговая полоса между «О нас» и «Как мы работаем»: рассказ о компании
  заканчивается, механика начинается. Отступы симметричные — секция ни к чему
  не примыкает и ни от кого их не наследует.
*/}
<section class="bg-brand py-16 text-white sm:py-20 lg:py-24">
  <div class="site-container">
    <h2 class="section-title">
      {values.title}
    </h2>

    <div class="mt-8 grid gap-x-12 lg:mt-12 lg:grid-cols-2">
      {
        values.items.map((item, i) => (
          <article
            data-anim
            data-anim-delay={Math.floor(i / 2) * 0.1}
            style={`--anim-x:${i % 2 === 0 ? '-100px' : '100px'}`}
            class="border-t border-line-on-brand py-6 sm:py-8 lg:py-9"
          >
            <h3 class="text-2xl leading-[1.2] text-balance">{item.title}</h3>
            <p class="mt-4 max-w-(--container-prose) leading-relaxed text-on-brand text-pretty sm:text-lg">
              {item.body}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
