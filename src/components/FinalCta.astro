---
import { finalCta, site } from '../content/landing';
---

<section class="bg-accent py-10 sm:py-14">
  <div class="site-container">
    <a
      href={site.bot}
      target="_blank"
      rel="noopener"
      class="cta glow-paper-lg bg-paper text-xl leading-snug text-balance text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-paper"
    >
      {finalCta.text}
    </a>
  </div>
</section>
