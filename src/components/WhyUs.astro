---
import { whyUs, site } from '../content/landing';

type Card = { title: string; body: readonly string[] };
const columns: readonly (readonly Card[])[] = [whyUs.left, whyUs.right];
---

<section id="adventages" class="site-container scroll-mt-24 py-16 sm:py-20 lg:py-28">
  <h2
    class="section-title"
  >
    {whyUs.title}
  </h2>

  <div class="mt-10 grid items-start gap-5 sm:gap-6 lg:mt-14 lg:grid-cols-2">
    {
      columns.map((column, ci) => (
        <div class="flex flex-col gap-5 sm:gap-6">
          {column.map((card, i) => (
            <article
              data-anim
              data-anim-delay={i * 0.1}
              style={`--anim-x:${ci === 0 ? '-100px' : '100px'}`}
              class="rounded-3xl border-2 border-accent bg-ink-deep/60 px-6 py-6 sm:px-8 sm:py-7">
              <h3 class="text-xl leading-[1.2] text-balance sm:text-2xl">
                {card.title}
              </h3>
              {card.body.map((p) => (
                <p class="mt-4 leading-relaxed text-paper/85 text-pretty sm:text-lg">{p}</p>
              ))}
            </article>
          ))}

          {/* кнопка живёт в правой колонке — как в оригинале */}
          {ci === 1 && (
            <a
              href={site.bot}
              target="_blank"
              rel="noopener"
              class="cta glow-accent-lg bg-accent text-lg text-paper focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-light"
            >
              {whyUs.cta}
            </a>
          )}
        </div>
      ))
    }
  </div>
</section>
