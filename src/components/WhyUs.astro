---
import { whyUs, ctas } from '../content/landing';

type Card = { title: string; body: readonly string[] };

/*
  Оригинал: шесть одинаковых карточек в две колонки, у каждой двухпиксельная
  фиолетовая рамка. Рядом «Ценности» — ещё четыре такие же. Две секции подряд
  читались как один повторяющийся приём.

  Здесь сильнейшее утверждение выходит из сетки и становится вступительным
  заявлением (какое именно — задаёт поле `lead` в landing.ts), а остальные
  живут белыми карточками на брендовой заливке. Двухпиксельные рамки сняты:
  именно они делали секцию похожей на форму.
*/
const { lead } = whyUs;
const columns: readonly (readonly Card[])[] = [whyUs.left, whyUs.right];
---

<section id="adventages" class="scroll-mt-24 bg-brand py-16 text-white sm:py-20 lg:py-28">
  <div class="site-container">
  <h2 class="section-title">
    {whyUs.title}
  </h2>

  {/* Вступительное заявление: не карточка, а утверждение во всю ширину */}
  <div
    data-anim
    style="--anim-y:40px"
    class="mt-10 grid gap-6 border-t border-line-on-brand pt-10 lg:mt-14 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-14 lg:pt-12"
  >
    <p class="text-2xl leading-[1.15] font-black text-balance sm:text-3xl lg:text-[2.75rem]">
      {lead.title}
    </p>
    <div class="flex flex-col justify-center gap-4">
      {lead.body.map((p) => (
        <p class="leading-relaxed text-on-brand text-pretty sm:text-lg">{p}</p>
      ))}
    </div>
  </div>

  <div class="mt-10 grid items-start gap-5 sm:gap-6 lg:mt-14 lg:grid-cols-2">
    {
      columns.map((column, ci) => (
        <div class="flex flex-col gap-5 sm:gap-6">
          {column.map((card, i) => (
            <article
              data-anim
              data-anim-delay={i * 0.1}
              style={`--anim-x:${ci === 0 ? '-100px' : '100px'}`}
              class="rounded-3xl bg-white px-6 py-6 text-ink sm:px-8 sm:py-7"
            >
              <h3 class="text-xl leading-[1.2] text-balance sm:text-2xl">
                {card.title}
              </h3>
              {card.body.map((p) => (
                <p class="mt-4 leading-relaxed text-ink-muted text-pretty sm:text-lg">{p}</p>
              ))}
            </article>
          ))}

          {/* кнопка живёт в правой колонке — как в оригинале.
              Пары с ботом здесь нет: она ведёт в форму, а бот стоит прямо
              над формой — дублировать его на полпути незачем. */}
          {ci === 1 && (
            <a href={ctas.formHref} class="cta cta-light text-lg">
              {whyUs.cta}
            </a>
          )}
        </div>
      ))
    }
  </div>
  </div>
</section>
