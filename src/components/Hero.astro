---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo-2line-a.svg';
import poster from '../assets/img/hero-poster.jpg';
import { hero, site } from '../content/landing';
---

{/*
  Фон: в оригинале это iframe с Rutube — плеер, его скрипты и три чужих
  счётчика ради двадцати секунд немого видео. Отдаём тот же ролик сами,
  <video> вместо iframe: ~1.4 МБ против плеера и без стороннего трекинга.
*/}
<section id="mainpic" class="relative isolate flex min-h-svh items-center overflow-hidden">
  <video
    class="absolute inset-0 -z-20 h-full w-full object-cover motion-reduce:hidden"
    poster={poster.src}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
    tabindex="-1"
  >
    <source src="/video/hero-bg.webm" type="video/webm" />
    <source src="/video/hero-bg.mp4" type="video/mp4" />
  </video>

  {/* при prefers-reduced-motion видео скрыто — остаётся статичный кадр */}
  <div
    class="absolute inset-0 -z-30 hidden bg-cover bg-center motion-reduce:block"
    style={`background-image:url(${poster.src})`}
    aria-hidden="true"
  >
  </div>

  {/* затемнение: кадры у ролика разной светлоты, поэтому под текстом
      плотнее, чем по краям — иначе на светлом кадре подпись тонет */}
  <div class="absolute inset-0 -z-10 bg-ink/75" aria-hidden="true"></div>
  <div
    class="absolute inset-0 -z-10 bg-linear-to-b from-ink/40 via-ink/10 to-ink/60"
    aria-hidden="true"
  >
  </div>

  <div class="site-container pt-28 pb-16 sm:pt-32 sm:pb-24">
    <div class="grid items-center gap-8 text-center sm:gap-10 lg:grid-cols-[minmax(0,35rem)_minmax(0,36.25rem)] lg:justify-between lg:gap-10 lg:text-left">
      <div>
        <Image
          src={logo}
          alt="TAO Transit"
          class="mx-auto w-60 sm:w-80 lg:mx-0 lg:w-[25rem]"
          loading="eager"
        />
        <p class="mt-4 text-lg leading-[1.55] text-balance sm:text-xl lg:mt-5 lg:max-w-[22rem] lg:text-[1.25rem] lg:text-pretty">
          {hero.tagline}
        </p>
      </div>

      <div class="lg:-translate-y-[53px]">
        <p class="text-lg leading-[1.55] text-balance sm:text-xl lg:text-[1.375rem] lg:text-pretty">
          {hero.lead}
        </p>
        <a
          href={site.manager}
          target="_blank"
          rel="noopener"
          class="cta glow-accent-lg mt-6 w-full bg-accent text-xl text-paper focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-light lg:mt-8"
        >
          {hero.cta}
        </a>
      </div>
    </div>
  </div>
</section>
