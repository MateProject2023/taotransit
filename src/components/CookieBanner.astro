---
import { cookieNotice } from '../content/legal';

/*
  Плашка про сбор данных. DESIGN.md § 6 относит куки-баннер к «карго-шаблону
  рунета» — запрет снят заказчиком, но снят ровно настолько, насколько нужно:

  — плашка не перекрывает страницу и не блокирует чтение, она стоит внизу
    и занимает одну колонку, а не всю ширину;
  — у неё есть настоящий отказ, а не одна кнопка «ок»: без выбора уведомление
    не считается согласием;
  — до ответа никакая аналитика не подключается, поэтому отказ что-то значит.

  Разметка отдаётся скрытой: без JS плашка не появится вовсе — но и считать
  без JS будет нечего. Так она не мигает и не двигает вёрстку.
*/
---

<div
  data-cookie-banner
  hidden
  class="fixed inset-x-3 bottom-3 z-50 sm:inset-x-auto sm:start-6 sm:bottom-6 sm:max-w-[26rem]"
>
  <div
    role="dialog"
    aria-live="polite"
    aria-label="Сбор данных на сайте"
    class="rounded-3xl border border-line-strong bg-panel px-4 py-4 sm:px-6 sm:py-5"
  >
    <p class="text-sm leading-relaxed text-fg-muted text-pretty">
      {cookieNotice.text}{' '}
      <button
        type="button"
        data-legal-open="cookie"
        class="rounded-sm text-accent underline underline-offset-4 transition-colors hover:text-fg"
      >
        {cookieNotice.more}
      </button>
    </p>

    <div class="mt-3 flex gap-2">
      <button
        type="button"
        data-cookie-accept
        class="flex min-h-11 grow basis-0 items-center justify-center rounded-xl bg-action px-4 font-bold whitespace-nowrap text-fg transition-colors hover:bg-accent hover:text-ground"
      >
        {cookieNotice.accept}
      </button>
      <button
        type="button"
        data-cookie-decline
        class="flex min-h-11 grow basis-0 items-center justify-center rounded-xl border border-line-strong px-4 whitespace-nowrap text-fg transition-[color,background-color,border-color] hover:border-accent hover:bg-accent hover:text-ground"
      >
        {cookieNotice.decline}
      </button>
    </div>
  </div>
</div>
