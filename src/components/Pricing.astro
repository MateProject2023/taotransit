---
import { pricing, site } from '../content/landing';
---

{/*
  Брендовая заливка, обе карточки белые. Раньше бумажной была только
  карточка комиссии, а тарифная стояла панелью — на светлой системе это
  дало бы серую поверхность внутри секции, прямой запрет пакета.
*/}
<section id="pricing" class="scroll-mt-24 bg-brand py-16 text-white sm:py-20 lg:py-24">
  <div class="site-container">
  <h2 class="section-title">
    {pricing.title}
  </h2>

  <div class="mt-8 grid gap-6 lg:mt-10 lg:grid-cols-2 lg:gap-8">
    <div
      class="rounded-3xl bg-white px-7 py-8 text-ink sm:px-9 sm:py-10"
    >
      <h3 class="headline text-balance">
        {pricing.commission.title}
      </h3>
      <div class="mt-6 space-y-5 sm:mt-8">
        {
          pricing.commission.body.map((p) => (
            <p class="leading-relaxed text-ink-muted text-pretty">{p}</p>
          ))
        }
      </div>
    </div>

    <div class="rounded-3xl bg-white px-6 py-7 text-ink sm:px-9 sm:py-9">
      <h3 class="headline">
        {pricing.table.title}
      </h3>

      <div
        class="mt-6 flex items-baseline justify-between gap-4 text-sm font-semibold sm:mt-8 sm:text-base"
      >
        <span>{pricing.table.head.term}</span>
        <span class="text-right">{pricing.table.head.price}</span>
      </div>

      <ul class="mt-4 space-y-4 sm:mt-5">
        {
          pricing.table.rows.map((row) => (
            <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-brand">
              <span class="sm:text-lg">{row.term}</span>
              {/* линия-выноска тянется между сроком и ценой, как в оригинале */}
              <span class="h-px min-w-6 flex-1 bg-line" aria-hidden="true" />
              <span class="ml-auto max-w-[60%] text-right text-pretty sm:text-lg">
                {row.price}
              </span>
            </li>
          ))
        }
      </ul>

      <p class="mt-7 text-sm leading-snug text-ink-muted sm:mt-8">
        {pricing.table.noteBefore}
        <a
          href={site.bot}
          target="_blank"
          rel="noopener"
          class="text-brand underline underline-offset-2 transition-colors hover:text-brand-deep"
        >
          {pricing.table.noteLink}
        </a>
      </p>
    </div>
  </div>
  </div>
</section>
