---
import { channel, site } from '../content/landing';
import { qrCode } from '../lib/qr';
import { telegramLabel } from '../lib/telegram';

/* И код, и подпись считаются на сборке из одного адреса: под кодом нужна не
   строка для копирования, а имя, которым канал ищут в телеграме. */
const qr = qrCode(site.channel);
const label = telegramLabel(site.channel);
---

{/*
  Плитка канала. Стоит в конце «О нас», сразу за змейкой «Все началось
  в 2013…»: история компании заканчивается, а канал — то место, где она
  продолжается на этой неделе.

  Заливка брендовая по просьбе заказчика, и это не третья поверхность:
  брендовая плита внутри бумажной секции — приём, который на странице уже
  есть, плита-гарантия в «Почему мы?». Волосяной рамки поэтому нет: с
  бумагой фиолет спорит сам, обводка нужна только белому по белому.

  Соседняя секция «Ценности» под плитку не годится: она залита целиком, а
  карточка внутри залитой секции запрещена прямо.

  Ссылок две и ведут они в разные места: заголовок — в сам пост, код —
  в канал. Это разные действия: прочитать одно и подписаться на всё.
*/}
<div class="mt-16 rounded-3xl bg-brand p-6 text-white sm:p-10 lg:mt-20">
  <div class="flex flex-col items-center gap-8 text-center sm:flex-row sm:items-center sm:justify-between sm:gap-12 sm:text-left">
    <div class="max-w-(--container-prose)">
      <h3 class="text-2xl leading-tight font-black sm:text-3xl">{channel.title}</h3>
      <p class="mt-3 text-base text-on-brand text-pretty sm:text-lg">{channel.body}</p>

      {/* Волосяная линия на заливке — свой токен: #8D8F99 на фиолете даёт
          1.52:1 и линией быть перестаёт. */}
      <hr class="my-6 border-t border-line-on-brand" />

      <p class="text-sm text-on-brand">{channel.latestLabel}</p>
      {/*
        Ведёт в сам пост, а не в канал: человек уже прочитал заголовок, и
        высадить его на ленту значит заставить искать то, что ему только что
        показали.

        Наведение гасит белое до --on-brand — тот же ход, что у пунктов
        аккордеона «Услуги»; вверх по светлоте от белого идти некуда.
        Кольцо фокуса переопределено на белое: базовое брендовое на этой
        заливке невидимо.
      */}
      <a
        href={channel.latestHref}
        target="_blank"
        rel="noopener"
        class="group mt-2 block rounded-sm focus-visible:outline-white"
      >
        <span class="text-lg leading-snug font-bold text-balance transition-colors group-hover:text-on-brand sm:text-xl">
          {channel.latestTitle}
        </span>
        <span class="mt-2 block text-sm text-on-brand text-pretty sm:text-base">
          {channel.latestBody}
        </span>
      </a>
    </div>

    <a
      href={site.channel}
      target="_blank"
      rel="noopener"
      class="group flex shrink-0 flex-col items-center gap-3 rounded-lg focus-visible:outline-white"
    >
      {/*
        Плашка под кодом белая и не обсуждается: сканеры порогуют яркость и
        ждут тёмное на светлом, инвертированный код половина из них просто
        не увидит. Зона покоя в четыре модуля уже заложена внутрь viewBox
        и прозрачна, то есть белая здесь же, — `p-2` добавлен только ради
        внятного края.

        Модули брендовые, а не чернильные: 10.71:1 на белом сканеру хватает
        с запасом, а плашка не становится чёрным пятном на заливке.
        Проверено чтением, а не на глаз: `scripts/qr-audit.mjs`.
      */}
      <span class="rounded-2xl bg-white p-2">
        <svg
          viewBox={`0 0 ${qr.size} ${qr.size}`}
          class="block size-36 text-brand sm:size-40"
          shape-rendering="crispEdges"
          data-qr
          aria-hidden="true"
          focusable="false"
        >
          <path d={qr.d} fill="currentColor" />
        </svg>
      </span>
      <span class="text-sm text-on-brand underline decoration-[0.5px] underline-offset-4 transition-colors group-hover:text-white">
        {label}
      </span>
    </a>
  </div>
</div>
