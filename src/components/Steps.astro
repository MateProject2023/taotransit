---
import { steps } from '../content/landing';
---

{/*
  Оригинал — пять карточек в ряд разной высоты (следствие ручных координат
  Zero Block). На 1200px каждая колонка выходила ~230px, а на планшете ряд
  разваливался в 2+2+1.

  Здесь это пять строк манифеста: римская цифра, срок, описание. Сроки
  выстраиваются в колонку и читаются как накладная — ровно то, ради чего
  затевалась «цифра как герой». Побочный выигрыш: на телефоне строки
  не ломаются вообще, отдельная мобильная раскладка не нужна.
*/}
<section id="steps" class="scroll-mt-24 bg-brand py-16 sm:py-20 lg:py-24">
  <div class="site-container">
    <h2 class="section-title">
      {steps.title}
    </h2>

    <ol class="mt-8 lg:mt-12">
      {
        steps.items.map((step, i) => (
          <li
            data-anim
            data-anim-delay={i * 0.06}
            style="--anim-y:48px"
            class="grid grid-cols-[2.5rem_1fr] items-baseline gap-x-4 gap-y-2 border-t border-line-on-brand py-6 last:border-b sm:gap-x-6 lg:grid-cols-[3.5rem_17rem_1fr] lg:py-8"
          >
            <span
              class="figure-lead text-xl text-accent sm:text-2xl lg:text-3xl"
              aria-hidden="true"
            >
              {step.numeral}
            </span>
            <p class="figure-lead text-3xl sm:text-4xl lg:text-[2.75rem]">
              {step.duration}
            </p>
            <p class="col-span-2 leading-snug text-on-brand text-pretty sm:text-lg lg:col-span-1 lg:pl-4 lg:text-xl">
              {step.text}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
