---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo-footer-ink.svg';
import bisma from '../assets/img/bisma-logo.png';
import { footer, site, footerLegal } from '../content/landing';
import { qrCode } from '../lib/qr';
import { telegramLabel } from '../lib/telegram';

const href = (key: keyof typeof site) =>
  key === 'email' ? `mailto:${site.email}` : site[key];

/* Дорожка бегущей строки: два одинаковых набора, поэтому сдвиг на -50%
   в @keyframes попадает точно на стык и повтор не заметен. */
const REPEAT = 8;

/* И код, и подпись считаются здесь, на сборке, из одного адреса: под кодом
   нужна не строка для копирования, а имя, которым канал ищут в телеграме. */
const channelQr = qrCode(site.channel);
const channelLabel = telegramLabel(site.channel);
---

{/*
  Контакты — перенесённый из mate приём (`Footer/ContactLine.jsx`):
  полосы во всю ширину экрана вместо колонки ссылок у правого края.
  Прежняя раскладка оставляла пустыми две трети ширины; здесь ширина
  занята по построению, а сама полоса — крупная цель для курсора.
*/}
<footer id="contacts" class="scroll-mt-24 pt-14 sm:pt-20">
  <div class="site-container">
    <h2 class="text-4xl leading-none font-black sm:text-5xl">{footer.title}</h2>
  </div>

  {/* Разделителя над лентой больше нет: полосы стали брендовыми, и верхний
      край первой из них сам отделяет её от заголовка. */}
  <ul class="mt-8 sm:mt-10">
    {
      footer.links.map((link) => {
        const isEmail = link.href === 'email';
        const running = 'reveal' in link ? link.reveal : link.label;
        return (
          <li>
            <a
              href={href(link.href as keyof typeof site)}
              {...isEmail ? {} : { target: '_blank', rel: 'noopener' }}
              class="contact-line group"
              data-contact
              data-copy={isEmail ? site.email : undefined}
            >
              {/* Слой под шторкой. Он декоративный: подпись и адрес
                  уже есть в шторке, дублировать их для чтения с экрана
                  незачем. */}
              <span class="contact-reveal" aria-hidden="true">
                <span class="contact-track">
                  {Array.from({ length: REPEAT * 2 }).map(() => (
                    <span class="flex items-center gap-4 text-xl whitespace-nowrap sm:text-3xl">
                      {running}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="size-5 shrink-0 sm:size-7">
                        <path d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  ))}
                </span>
              </span>

              <span class="contact-cover">
                <span class="site-container flex items-center justify-between gap-6">
                  <span class="text-xl whitespace-nowrap sm:text-3xl" data-contact-label>{link.label}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="size-5 shrink-0 sm:size-7" aria-hidden="true">
                    <path d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>

  <div class="site-container pb-28 sm:pb-24">
    {/*
      Телеграм-канал. Его адрес есть и полосой выше, но полоса — это ссылка,
      а канал заказчик просил показать так, чтобы на него можно было
      подписаться с телефона, не трогая экран, с которого читают. Отсюда пара:
      код и подпись под ним.

      Белая карточка на бумаге с волосяной рамкой — Правило белой карточки:
      1.03:1 к бумаге само по себе объектом не читается.
    */}
    <div class="mt-14 rounded-3xl border border-line bg-white p-6 sm:mt-20 sm:p-10">
      {/* Текст слева, код справа — тем же построением, что нижняя строка
          футера: марка слева, авторство справа. На узком экране порядок
          становится порядком чтения, заголовок первым. */}
      <div class="flex flex-col items-center gap-8 text-center sm:flex-row sm:items-center sm:justify-between sm:gap-10 sm:text-left">
        <div class="max-w-(--container-prose)">
          <h3 class="text-2xl leading-tight font-black sm:text-3xl">{footer.channel.title}</h3>
          <p class="mt-3 text-base text-ink-muted text-pretty sm:text-lg">{footer.channel.body}</p>
        </div>

        <a
          href={site.channel}
          target="_blank"
          rel="noopener"
          class="group flex shrink-0 flex-col items-center gap-3 rounded-lg"
        >
          {/*
            Код брендовый, а не чернильный: 10.71:1 на белом — сканеру этого
            с запасом хватает (он порогует яркость, а не тон), а страница не
            получает чёрного пятна там, где всё остальное фиолетовое.
            Проверено чтением, а не на глаз: `scripts/qr-audit.mjs`.

            Зона покоя в четыре модуля заложена внутрь viewBox, поэтому её
            нельзя срезать вёрсткой. `crispEdges` — чтобы сглаживание не
            размывало границы модулей на дробном масштабе.
          */}
          <svg
            viewBox={`0 0 ${channelQr.size} ${channelQr.size}`}
            class="size-36 text-brand sm:size-40"
            shape-rendering="crispEdges"
            data-qr
            aria-hidden="true"
            focusable="false"
          >
            <path d={channelQr.d} fill="currentColor" />
          </svg>
          <span class="text-sm text-ink-muted underline decoration-[0.5px] underline-offset-4 transition-colors group-hover:text-ink">
            {channelLabel}
          </span>
        </a>
      </div>
    </div>

    {/*
      Нижняя строка: марка слева, авторство справа, оба логотипа стоят на одной
      линии дна (`items-end`). «Created by» — подпись над логотипом бюро.
    */}
    <div class="mt-14 flex flex-wrap items-end justify-between gap-x-6 gap-y-8 sm:mt-20">
      <Image src={logo} alt="TAO Transit" loading="lazy" class="w-56 sm:w-72 lg:w-80" />

      <a
        href={site.bisma}
        target="_blank"
        rel="noopener"
        class="flex flex-col items-end gap-2"
      >
          <span class="text-sm text-ink-muted sm:text-base">{footer.createdBy}</span>
        {/* Логотип бюро существует только в белом варианте (Bisma_logo_white2x)
            и на бумаге исчезает полностью. Инвертировать нельзя — у него
            радужная рамка, инверсия даст дополнительные цвета. Поэтому он
            стоит на плашке — брендовой, как и шторки полос выше. */}
        <span class="rounded-lg bg-brand px-3 py-2">
          <Image src={bisma} alt="BISMA" loading="lazy" class="h-7 w-auto sm:h-9" />
        </span>
      </a>
    </div>

    {/*
      Документы. Одной колонкой под маркой, по левому краю, мелко и плотно:
      это выходные данные, а не пункты меню. Открываются модальными окнами —
      отдельных адресов у них пока нет, см. CLAUDE.md § «Юридические документы».
    */}
    <ul class="mt-3 flex flex-col items-start gap-1">
      {
        footerLegal.map((doc) => (
          /* flex у пункта убирает строчную распорку: у inline-кнопки под ней
             остаётся собственный интерлиньяж, и шаг между строками получался
             вдвое больше заданного gap. */
          <li class="flex">
            <button
              type="button"
              data-legal-open={doc.id}
              class="rounded-sm text-[0.6875rem] leading-snug font-normal text-ink-muted underline decoration-[0.5px] underline-offset-2 transition-colors hover:text-ink sm:text-xs"
            >
              {doc.label}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
